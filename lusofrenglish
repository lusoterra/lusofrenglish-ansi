// Luso-Frenglish: US ANSI layout with AltGr dead keys, optimized
// for typing Portuguese, French and English.
// Base: QWERTY (us basic). Accents via AltGr (level 3) direct
// characters and dead keys. Right Alt = AltGr.

partial alphanumeric_keys
xkb_symbols "basic" {

    include "us(basic)"
    name[Group1]= "English (Luso-FrEnglish, AltGr dead keys)";

    // Top row
    key <TLDE> { [     grave, asciitilde,      dead_grave,        dead_tilde ] };
    key <AE01> { [         1,     exclam,      NoSymbol,     dead_abovedot ] };
    key <AE02> { [         2,         at,     twosuperior,  dead_doubleacute ] };
    key <AE03> { [         3, numbersign,   threesuperior,       dead_macron ] };
    key <AE04> { [         4,     dollar,            cent,               yen ] };
    key <AE05> { [         5,    percent,        EuroSign,          sterling ] };
    key <AE06> { [         6,asciicircum, dead_circumflex,        dead_caron ] };
    key <AE07> { [         7,  ampersand,       trademark,         registered ] };
    key <AE08> { [         8,   asterisk,    dead_abovedot,        dead_greek ] };
    key <AE09> { [         9,  parenleft,    NoSymbol,         NoSymbol ] };
    key <AE10> { [         0, parenright,    NoSymbol,         NoSymbol ] };
    key <AE11> { [     minus, underscore,    NoSymbol,         NoSymbol ] };
    key <AE12> { [     equal,       plus,          degree,    dead_abovering ] };

    // Upper row
    key <AD01> { [         q,          Q,          agrave,            Agrave ] };
    key <AD02> { [         w,          W,          egrave,            Egrave ] };
    key <AD03> { [         e,          E,          eacute,            Eacute ] };
    key <AD04> { [         r,          R,     ecircumflex,       Ecircumflex ] };
    key <AD05> { [         t,          T,        NoSymbol,         NoSymbol ] };
    key <AD06> { [         y,          Y,          ugrave,            Ugrave ] };
    key <AD07> { [         u,          U,          uacute,            Uacute ] };
    key <AD08> { [         i,          I,          iacute,            Iacute ] };
    key <AD09> { [         o,          O,          oacute,            Oacute ] };
    key <AD10> { [         p,          P,          ograve,            Ograve ] };
    key <AD11> { [ bracketleft, braceleft,  guillemotleft,             U2039 ] };
    key <AD12> { [bracketright,braceright, guillemotright,             U203A ] };

    // Home row
    key <AC01> { [         a,          A,          aacute,            Aacute ] };
    key <AC02> { [         s,          S,        NoSymbol,         NoSymbol ] };
    key <AC03> { [         d,          D,        NoSymbol,         NoSymbol ] };
    key <AC04> { [         f,          F,              ae,                AE ] };
    key <AC05> { [         g,          G,     icircumflex,       Icircumflex ] };
    key <AC06> { [         h,          H,     ucircumflex,       Ucircumflex ] };
    key <AC07> { [         j,          J,          ugrave,            Ugrave ] };
    key <AC08> { [         k,          K,      idiaeresis,        Idiaeresis ] };
    key <AC09> { [         l,          L,          otilde,            Otilde ] };
    key <AC10> { [ semicolon,      colon,     ocircumflex,       Ocircumflex ] };
    key <AC11> { [apostrophe,   quotedbl,      dead_acute,    dead_diaeresis ] };

    // Bottom row
    key <AB01> { [         z,          Z,          atilde,            Atilde ] };
    key <AB02> { [         x,          X,     acircumflex,       Acircumflex ] };
    key <AB03> { [         c,          C,        ccedilla,          Ccedilla ] };
    key <AB04> { [         v,          V,        NoSymbol,         NoSymbol ] };
    key <AB05> { [         b,          B,        NoSymbol,         NoSymbol ] };
    key <AB06> { [         n,          N,        NoSymbol,         NoSymbol ] };
    key <AB07> { [         m,          M,          igrave,            Igrave ] };
    key <AB08> { [     comma,       less,        ccedilla,       dead_cedilla ] };
    key <AB09> { [    period,    greater,              oe,                OE ] };
    key <AB10> { [     slash,   question,    questiondown,       dead_stroke ] };
    key <BKSL> { [ backslash,        bar,    NoSymbol,         NoSymbol ] };

    include "level3(ralt_switch)"
};

// Alias so `setxkbmap -layout lusofrenglish` works without a variant.
partial alphanumeric_keys
xkb_symbols "default" {
    include "lusofrenglish(basic)"
};
